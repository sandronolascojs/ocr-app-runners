{
  "name": "ocr-app-runners",
  "version": "1.0.0",
  "description": "OCR App Runner - Inngest server",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "dotenv -e .env -- tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "inngest",
    "ocr",
    "runner"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.948.0",
    "@aws-sdk/lib-storage": "^3.948.0",
    "@aws-sdk/s3-request-presigner": "^3.948.0",
    "@neondatabase/serverless": "^1.0.2",
    "@paralleldrive/cuid2": "^3.0.4",
    "@t3-oss/env-core": "^0.13.8",
    "@types/archiver": "^7.0.0",
    "@types/node": "^25.0.0",
    "archiver": "^7.0.1",
    "docx": "^9.5.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "eslint": "^9.39.1",
    "express": "^5.2.1",
    "inngest": "^4.1.0",
    "jose": "^6.1.3",
    "openai": "^6.10.0",
    "sharp": "^0.34.5",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "yauzl": "3.2.0",
    "zod": "^4.1.13"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.9.0",
